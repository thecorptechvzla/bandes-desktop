{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandes",
  "version": "0.1.8",
  "identifier": "com.bandes.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build:export",
    "frontendDist": "../out"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' http://127.0.0.1:3001 ws://127.0.0.1:3001 http://192.168.1.108:8090",
        "img-src": "'self' data: blob: http://127.0.0.1:3001 https:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "media-src": "'self' https:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/backend-api"],
    "shortDescription": "Sistema de trazabilidad de fundicion y boveda de oro (LAN)",
    "longDescription": "Bandes Desktop: trazabilidad de oro, boveda multi-proveedor y lectura de balanza, operando 100% en red local."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCQTZENjMyQjdCQzZFNUMKUldSY2JyeTNNdGFtVzREMlk3Rk1yYkcxZlRXeXN6R09kY2hnTDF3M1Q4Z0UwQkNuVm5jVTBweU0K",
      "endpoints": [
        "http://192.168.1.108:8090/latest.json"
      ],
      "dangerousInsecureTransportProtocol": true
    }
  }
}